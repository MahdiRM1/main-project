CC = gcc
CFLAGS = -Wall -std=c99 -ID:/raylib/include
LDFLAGS = -LD:/raylib/lib -lraylib -lopengl32 -lgdi32 -lwinmm -static-libgcc

all: program.exe

program.exe: main.o printmap.o generateMap.o updategame.o War.o gameInformation.o info.o Computer.o setupScreen.o
	$(CC) -o program.exe main.o printmap.o generateMap.o updategame.o War.o gameInformation.o info.o Computer.o setupScreen.o $(LDFLAGS)

main.o: main.c printmap.h generateMap.h updategame.h setupScreen.h
	$(CC) $(CFLAGS) -c main.c

printmap.o: printmap.c printmap.h
	$(CC) $(CFLAGS) -c printmap.c

generateMap.o: generateMap.c generateMap.h
	$(CC) $(CFLAGS) -c generateMap.c

updategame.o: updategame.c updategame.h
	$(CC) $(CFLAGS) -c updategame.c

War.o: War.c War.h
	$(CC) $(CFLAGS) -c War.c

gameInformation.o: gameInformation.c gameInformation.h
	$(CC) $(CFLAGS) -c gameInformation.c

info.o: info.c info.h
	$(CC) $(CFLAGS) -c info.c

Computer.o: Computer.c Computer.h
	$(CC) $(CFLAGS) -c Computer.c

setupScreen.o: setupScreen.c setupScreen.h generateMap.h gameInformation.h
	$(CC) $(CFLAGS) -c setupScreen.c

clean:
	rm -f *.o program.exe
